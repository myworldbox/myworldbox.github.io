[
  {
    "index": 1,
    "label": "禍福無門，唯人所召",
    "source": "左傳．襄公二十三年",
    "author": "左丘明"
  },
  {
    "index": 2,
    "label": "舉棋不定，不勝其耦",
    "source": "左傳．襄公二十五年",
    "author": "左丘明"
  },
  {
    "index": 3,
    "label": "天下熙熙，皆為利來",
    "source": "史記．貨殖列傳",
    "author": "司馬遷"
  },
  {
    "index": 4,
    "label": "天下攘攘，皆為利往",
    "source": "史記．貨殖列傳",
    "author": "司馬遷"
  },
  {
    "index": 5,
    "label": "君子藏器於身，待時而動",
    "source": "周易．繫辭下",
    "author": null
  },
  {
    "index": 6,
    "label": "狡兔死，走狗烹",
    "source": "史記．越王勾踐世家",
    "author": "司馬遷"
  },
  {
    "index": 7,
    "label": "飛鳥盡，良弓藏",
    "source": "史記．越王勾踐世家",
    "author": "司馬遷"
  },
  {
    "index": 8,
    "label": "敵國破，謀臣亡",
    "source": "史記．淮陰侯列傳",
    "author": "司馬遷"
  },
  {
    "index": 9,
    "label": "有志者事竟成",
    "source": "後漢書．耿弇傳",
    "author": "范曄"
  },
  {
    "index": 10,
    "label": "前車覆，後車誡",
    "source": "漢書．賈誼傳",
    "author": "班固"
  },
  {
    "index": 11,
    "label": "三十六策，走為上策",
    "source": "南齊書．王敬則傳",
    "author": "蕭子顯"
  },
  {
    "index": 12,
    "label": "司馬昭之心，路人皆知也",
    "source": "三國志．魏書．高貴鄉公紀",
    "author": "陳壽"
  },
  {
    "index": 13,
    "label": "桃李不言，下自成蹊",
    "source": "史記．李將軍列傳",
    "author": "司馬遷"
  },
  {
    "index": 14,
    "label": "禍不妄至，福不徒來",
    "source": "史記．龜策列傳",
    "author": "司馬遷"
  },
  {
    "index": 15,
    "label": "當斷不斷，反受其亂",
    "source": "史記．春申君列傳",
    "author": "司馬遷"
  },
  {
    "index": 16,
    "label": "人棄我取，人取我與",
    "source": "史記．貨殖列傳",
    "author": "司馬遷"
  },
  {
    "index": 17,
    "label": "智者千慮，必有一失",
    "source": "史記．淮陰侯列傳",
    "author": "司馬遷"
  },
  {
    "index": 18,
    "label": "愚者千慮，必有一得",
    "source": "史記．淮陰侯列傳",
    "author": "司馬遷"
  },
  {
    "index": 19,
    "label": "燕雀安知鴻鵠之志哉",
    "source": "史記．陳涉世家",
    "author": "司馬遷"
  },
  {
    "index": 20,
    "label": "王侯將相寧有種乎",
    "source": "史記．陳涉世家",
    "author": "司馬遷"
  },
  {
    "index": 21,
    "label": "顧小而忘大，後必有害",
    "source": "史記．李斯列傳",
    "author": "司馬遷"
  },
  {
    "index": 22,
    "label": "運籌帷幄之中，決勝千里之外",
    "source": "史記．高祖本紀",
    "author": "司馬遷"
  },
  {
    "index": 23,
    "label": "人方為刀俎，我為魚肉",
    "source": "史記．項羽本紀",
    "author": "司馬遷"
  },
  {
    "index": 24,
    "label": "生當作人傑，死亦為鬼雄",
    "source": "夏日絕句",
    "author": "李清照"
  },
  {
    "index": 25,
    "label": "敗軍之將，不可以言勇",
    "source": "史記．淮陰侯列傳",
    "author": "司馬遷"
  },
  {
    "index": 26,
    "label": "以三寸之舌，彊於百萬之師",
    "source": "史記．平原君虞卿列傳",
    "author": "司馬遷"
  },
  {
    "index": 27,
    "label": "黃金有疵，白玉有瑕",
    "source": "史記．龜策列傳",
    "author": "司馬遷"
  },
  {
    "index": 28,
    "label": "得黃金百，不如得季布一諾",
    "source": "史記．季布欒布列傳",
    "author": "司馬遷"
  },
  {
    "index": 29,
    "label": "置將不善，壹敗塗地",
    "source": "史記．高祖本紀",
    "author": "司馬遷"
  },
  {
    "index": 30,
    "label": "富貴多士，貧賤寡友",
    "source": "史記．孟嘗君列傳",
    "author": "司馬遷"
  },
  {
    "index": 31,
    "label": "恃德者昌，恃力者亡",
    "source": "尚書．仲虺之誥",
    "author": null
  },
  {
    "index": 32,
    "label": "禍兮福所倚，福兮禍所伏",
    "source": "道德經",
    "author": "老子"
  },
  {
    "index": 33,
    "label": "人貌榮名，豈有既乎",
    "source": "史記．游俠列傳",
    "author": "司馬遷"
  },
  {
    "index": 34,
    "label": "時乎時，不再來",
    "source": "漢書．蒯通傳",
    "author": "班固"
  },
  {
    "index": 35,
    "label": "言必信，行必果",
    "source": "論語．子路",
    "author": "孔子"
  },
  {
    "index": 36,
    "label": "始之易，終之難也",
    "source": "戰國策．燕策",
    "author": null
  },
  {
    "index": 37,
    "label": "千里之行，始於足下",
    "source": "道德經",
    "author": "老子"
  },
  {
    "index": 38,
    "label": "信言不美，美言不信",
    "source": "道德經",
    "author": "老子"
  },
  {
    "index": 39,
    "label": "執古之道，以御今之有",
    "source": "道德經",
    "author": "老子"
  },
  {
    "index": 40,
    "label": "夫哀莫大於心死",
    "source": "莊子．田子方",
    "author": "莊子"
  },
  {
    "index": 41,
    "label": "將欲取之，必固與之",
    "source": "道德經",
    "author": "老子"
  },
  {
    "index": 42,
    "label": "天地有萬古，此身不再得",
    "source": "菜根譚",
    "author": "洪應明"
  },
  {
    "index": 43,
    "label": "巧詐不如拙誠",
    "source": "韓非子．說林上",
    "author": "韓非"
  },
  {
    "index": 44,
    "label": "雖萬被戮，豈有悔哉",
    "source": "報任安書",
    "author": "司馬遷"
  },
  {
    "index": 45,
    "label": "他山之石，可以攻玉",
    "source": "詩經．小雅．鶴鳴",
    "author": null
  },
  {
    "index": 46,
    "label": "踏破鐵鞋無覓處，得來全不費工夫",
    "source": "絕句",
    "author": "夏元鼎"
  },
  {
    "index": 47,
    "label": "項王之勇，千古無雙",
    "source": "史記．項羽本紀",
    "author": "司馬遷"
  },
  {
    "index": 48,
    "label": "千磨萬擊還堅勁，任爾東西南北風",
    "source": "竹石",
    "author": "鄭燮"
  },
  {
    "index": 49,
    "label": "暴霜露，斬荊棘",
    "source": "六國論",
    "author": "蘇洵"
  },
  {
    "index": 50,
    "label": "沖天香陣透長安，滿城盡帶黃金甲",
    "source": "不第後賦菊",
    "author": "黃巢"
  },
  {
    "index": 51,
    "label": "待到秋來九月八，我花開後百花殺",
    "source": "不第後賦菊",
    "author": "黃巢"
  },
  {
    "index": 52,
    "label": "他年我若為青帝，報與桃花一處開",
    "source": "題菊花",
    "author": "黃巢"
  },
  {
    "index": 53,
    "label": "欲窮千里目，更上一層樓",
    "source": "登鸛雀樓",
    "author": "王之渙"
  },
  {
    "index": 54,
    "label": "長風破浪會有時，直掛雲帆濟滄海",
    "source": "行路難",
    "author": "李白"
  },
  {
    "index": 55,
    "label": "天生我材必有用，千金散盡還復來",
    "source": "將進酒",
    "author": "李白"
  },
  {
    "index": 56,
    "label": "人生得意須盡歡，莫使金樽空對月",
    "source": "將進酒",
    "author": "李白"
  },
  {
    "index": 57,
    "label": "居安思危，思則有備",
    "source": "左傳．襄公十一年",
    "author": "左丘明"
  },
  {
    "index": 58,
    "label": "寧為玉碎，不為瓦全",
    "source": "北齊書．元景安傳",
    "author": "李百藥"
  },
  {
    "index": 59,
    "label": "不積跬步，無以至千里",
    "source": "荀子．勸學",
    "author": "荀子"
  },
  {
    "index": 60,
    "label": "士為知己者死，女為悅己者容",
    "source": "戰國策．趙策",
    "author": null
  },
  {
    "index": 61,
    "label": "對酒當歌，人生幾何",
    "source": "短歌行",
    "author": "曹操"
  },
  {
    "index": 62,
    "label": "烈士暮年，壯心不已",
    "source": "龜雖壽",
    "author": "曹操"
  },
  {
    "index": 63,
    "label": "老驥伏櫪，志在千里",
    "source": "龜雖壽",
    "author": "曹操"
  },
  {
    "index": 64,
    "label": "是可忍，孰不可忍",
    "source": "論語．八佾",
    "author": "孔子"
  },
  {
    "index": 65,
    "label": "或重於泰山，或輕於鴻毛",
    "source": "報任安書",
    "author": "司馬遷"
  },
  {
    "index": 66,
    "label": "譬如遼東死，斬頭何所傷",
    "source": "無向遼東浪死歌",
    "author": "王薄"
  },
  {
    "index": 67,
    "label": "振長策而御宇內，吞二周而亡諸侯",
    "source": "過秦論",
    "author": "賈誼"
  },
  {
    "index": 68,
    "label": "不以物喜，不以己悲",
    "source": "岳陽樓記",
    "author": "范仲淹"
  },
  {
    "index": 69,
    "label": "先天下之憂而憂，後天下之樂而樂",
    "source": "岳陽樓記",
    "author": "范仲淹"
  },
  {
    "index": 70,
    "label": "投之亡地然後存，陷之死地然後生",
    "source": "孫子兵法．九地篇",
    "author": "孫武"
  },
  {
    "index": 71,
    "label": "兵貴神速",
    "source": "孫子兵法．九地篇",
    "author": "孫武"
  },
  {
    "index": 72,
    "label": "兵者，詭道也",
    "source": "孫子兵法．始計篇",
    "author": "孫武"
  },
  {
    "index": 73,
    "label": "銳卒勿攻，餌兵勿食",
    "source": "孫子兵法．軍爭篇",
    "author": "孫武"
  },
  {
    "index": 74,
    "label": "兵無常勢，水無常形",
    "source": "孫子兵法．虛實篇",
    "author": "孫武"
  },
  {
    "index": 75,
    "label": "利而誘之，亂而取之",
    "source": "孫子兵法．虛實篇",
    "author": "孫武"
  },
  {
    "index": 76,
    "label": "圍師必闕，窮寇勿迫",
    "source": "孫子兵法．圍地篇",
    "author": "孫武"
  },
  {
    "index": 77,
    "label": "天地不仁，以萬物為芻狗",
    "source": "道德經．第五章",
    "author": "老子"
  },
  {
    "index": 78,
    "label": "天道好輪回，蒼天饒過誰",
    "source": "民間諺語",
    "author": "未知"
  },
  {
    "index": 79,
    "label": "帝陰養死士三千，散在人間",
    "source": "晉書．帝紀第二",
    "author": "佚名"
  },
  {
    "index": 80,
    "label": "斬木為兵，揭竿為旗",
    "source": "過秦論．上篇",
    "author": "賈誼"
  },
  {
    "index": 81,
    "label": "屋漏偏逢連夜雨",
    "source": "醒世恆言．第三十五卷",
    "author": "馮夢龍"
  },
  {
    "index": 82,
    "label": "怒髮衝冠，憑欄處",
    "source": "滿江紅．寫懷",
    "author": "岳飛"
  },
  {
    "index": 83,
    "label": "元嘉草草，封狼居胥",
    "source": "永遇樂．京口北固亭懷古",
    "author": "辛棄疾"
  },
  {
    "index": 84,
    "label": "仁義不施，而攻守之勢異也",
    "source": "過秦論",
    "author": "賈誼"
  },
  {
    "index": 85,
    "label": "故禍莫憯於欲利，悲莫痛於傷心",
    "source": "史記．報任少卿書",
    "author": "司馬遷"
  },
  {
    "index": 86,
    "label": "轉鬭千里，矢盡道窮",
    "source": "史記．報任少卿書",
    "author": "司馬遷"
  },
  {
    "index": 87,
    "label": "若九牛亡一毛，與螻螘何以異",
    "source": "史記．報任少卿書",
    "author": "司馬遷"
  },
  {
    "index": 88,
    "label": "是以腸一日而九回，居則忽忽若有所亡",
    "source": "史記．報任少卿書",
    "author": "司馬遷"
  },
  {
    "index": 89,
    "label": "舉世皆濁，何不隨其流而揚其波",
    "source": "史記．屈原列傳",
    "author": "司馬遷"
  },
  {
    "index": 90,
    "label": "蝸牛角上爭何事，石火光中寄此身",
    "source": "對酒",
    "author": "白居易"
  },
  {
    "index": 91,
    "label": "山重水複疑無路，柳暗花明又一村",
    "source": "遊山西村",
    "author": "陸遊"
  },
  {
    "index": 92,
    "label": "知君何事淚縱橫，斷腸聲裡憶平生",
    "source": "浣溪沙．殘雪凝輝冷畫屏",
    "author": "納蘭性德"
  },
  {
    "index": 93,
    "label": "莫等閒，白了少年頭",
    "source": "滿江紅．寫懷",
    "author": "岳飛"
  },
  {
    "index": 94,
    "label": "肉食者鄙，未能遠謀",
    "source": "曹劌論戰",
    "author": "左丘明"
  },
  {
    "index": 95,
    "label": "巧言令色，鮮矣仁",
    "source": "論語．學而篇",
    "author": "孔子"
  },
  {
    "index": 96,
    "label": "千夫所指，無疾而死",
    "source": "史記．李將軍列傳",
    "author": "司馬遷"
  },
  {
    "index": 97,
    "label": "小不忍則亂大謀",
    "source": "論語．衛靈公",
    "author": "孔子"
  },
  {
    "index": 98,
    "label": "故天將降大任於是人也",
    "source": "孟子．告子章句下",
    "author": "孟子"
  },
  {
    "index": 99,
    "label": "苟利國家生死以，豈因禍福避趨之",
    "source": "赴戍登程口占示家人．二首",
    "author": "林則徐"
  },
  {
    "index": 100,
    "label": "快牛為犢多能破車",
    "source": "冉氏烹調狗記",
    "author": "崔述"
  },
  {
    "index": 101,
    "label": "了卻君王天下事，贏得生前後名",
    "source": "破陣子．為陳同甫賦壯詞以寄之",
    "author": "辛棄疾"
  },
  {
    "index": 102,
    "label": "江南亦有何罪，但天下一家",
    "source": "續資治通鑑長編．卷一二",
    "author": "李燾"
  },
  {
    "index": 103,
    "label": "臥榻之側，豈容他人鼾睡",
    "source": "續資治通鑑長編．卷一二",
    "author": "李燾"
  },
  {
    "index": 104,
    "label": "蛟龍得雲雨，非復池中物",
    "source": "晉書．載記第一",
    "author": "佚名"
  },
  {
    "index": 105,
    "label": "我一時英雄，何為不可作帝王邪",
    "source": "晉書．卷一百七",
    "author": "佚名"
  },
  {
    "index": 106,
    "label": "非常之事，豈常人所能",
    "source": "晉書．王敦傳",
    "author": "佚名"
  },
  {
    "index": 107,
    "label": "自謂經略指授，算無遺策",
    "source": "晉書．桓玄傳",
    "author": "佚名"
  },
  {
    "index": 108,
    "label": "雕欄玉砌應猶在，只是朱顏改",
    "source": "虞美人．春花秋月何時了",
    "author": "李煜"
  },
  {
    "index": 109,
    "label": "春花秋月何時了，往事知多少",
    "source": "虞美人．春花秋月何時了",
    "author": "李煜"
  },
  {
    "index": 110,
    "label": "小樓昨夜又東風，故國不堪回首月明中",
    "source": "虞美人．春花秋月何時了",
    "author": "李煜"
  },
  {
    "index": 111,
    "label": "往事已成空，還如一夢中",
    "source": "子夜歌．人生愁恨何能免",
    "author": "李煜"
  },
  {
    "index": 112,
    "label": "剪不斷，理還亂",
    "source": "相見歡．無言獨上西樓",
    "author": "李煜"
  },
  {
    "index": 113,
